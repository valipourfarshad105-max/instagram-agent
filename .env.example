# ══════════════════════════════════════════════════════════
#  کلیدها و توکن‌ها  —  این فایل را به .env کپی کنید
#  cp .env.example .env
# ══════════════════════════════════════════════════════════

# ---------- تولید محتوا (متن و تصویر) ----------
# یکی از این دو را پر کنید (یا هیچکدام = حالت آفلاین/قالبی)
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---------- اینستاگرام (Instagram Graph API) ----------
# نوع لاگین: instagram (بدون نیاز به پیج فیسبوک) یا facebook (نیازمند پیج)
IG_LOGIN=instagram
IG_ACCESS_TOKEN=
IG_USER_ID=

# فقط اگر IG_LOGIN=facebook یا برای گرفتن توکن لازم است
FB_APP_ID=
FB_APP_SECRET=

# ---------- آپلود ویدیو به یک URL عمومی ----------
# گزینه‌ها: uguu | catbox | litterbox | s3 | local
#   uguu/litterbox/catbox : بدون نیاز به کلید (لینک موقت – برای تست عالی، برای تولید نه)
#   s3                    : Cloudflare R2 / AWS S3 (پیشنهاد من برای استفادهٔ واقعی)
#   local                 : از PUBLIC_BASE_URL خودتان سرو می‌شود
UPLOADER=uguu
PUBLIC_BASE_URL=

# اگر UPLOADER=s3 :
S3_ENDPOINT_URL=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

# ---------- داشبورد تأیید ----------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=

# ---------- اعلان تلگرام (اختیاری، برای حالت تأیید دستی) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- متفرقه ----------
# اگر ffmpeg سیستم‌تان در PATH نیست، مسیر دقیق باینری را بدهید
FFMPEG_BIN=
